#include <windows.h>
#include "resources.h"

IDD_SETTINGS DIALOGEX 0, 0, 230, 150
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "opendisplay-win - Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "iPad IP:", -1, 10, 12, 40, 10
    EDITTEXT        IDC_IP, 55, 10, 165, 13, ES_AUTOHSCROLL
    LTEXT           "Port:", -1, 10, 32, 40, 10
    EDITTEXT        IDC_PORT, 55, 30, 55, 13, ES_AUTOHSCROLL | ES_NUMBER
    AUTOCHECKBOX    "Connect to the iPad automatically when running", IDC_AUTORECONNECT, 10, 52, 210, 10
    AUTOCHECKBOX    "Start with Windows (launch at logon)", IDC_AUTOSTART, 10, 66, 210, 10
    LTEXT           "Runs without admin. Admin is only needed once, to register a new iPad's resolution (you'll get a UAC prompt on first connect). ""Run as administrator"" from the tray menu also lets touch control elevated windows.",
                    -1, 10, 86, 210, 44
    DEFPUSHBUTTON   "OK", IDOK, 116, 130, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 130, 50, 15
END
