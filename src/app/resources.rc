#include <windows.h>
#include "resources.h"

// This file is UTF-8; without the code page the resource compiler reads it as
// the system ANSI code page and every non-ASCII character ends up mojibake in
// the dialog.
#pragma code_page(65001)

IDD_SETTINGS DIALOGEX 0, 0, 230, 203
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "opendisplay-win - Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "One iPad per line, address first, then a name of your choosing:", -1, 10, 8, 210, 10
    EDITTEXT        IDC_IP, 10, 20, 210, 48, ES_MULTILINE | ES_WANTRETURN | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT           "e.g. 192.168.1.42 Mini — the name is only for the tray menu.", -1, 10, 71, 210, 10
    LTEXT           "Port:", -1, 10, 86, 40, 10
    EDITTEXT        IDC_PORT, 55, 84, 55, 13, ES_AUTOHSCROLL | ES_NUMBER
    AUTOCHECKBOX    "Connect to the iPads automatically when running", IDC_AUTORECONNECT, 10, 104, 210, 10
    AUTOCHECKBOX    "Start with Windows (launch at logon)", IDC_AUTOSTART, 10, 118, 210, 10
    LTEXT           "Runs without admin. Admin is only needed once, to register a new iPad's resolution (you'll get a UAC prompt on first connect). ""Run as administrator"" from the tray menu also lets touch control elevated windows.",
                    -1, 10, 136, 210, 44
    DEFPUSHBUTTON   "OK", IDOK, 116, 182, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 170, 182, 50, 15
END
