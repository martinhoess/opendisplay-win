#include <windows.h>
#include "resources.h"

IDD_SETTINGS DIALOGEX 0, 0, 210, 96
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "opendisplay-win - Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "iPad IP:", -1, 10, 12, 40, 10
    EDITTEXT        IDC_IP, 55, 10, 145, 13, ES_AUTOHSCROLL
    LTEXT           "Port:", -1, 10, 32, 40, 10
    EDITTEXT        IDC_PORT, 55, 30, 55, 13, ES_AUTOHSCROLL | ES_NUMBER
    AUTOCHECKBOX    "Connect automatically on launch", IDC_AUTORECONNECT, 55, 50, 145, 10
    DEFPUSHBUTTON   "OK", IDOK, 96, 74, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 150, 74, 50, 15
END
